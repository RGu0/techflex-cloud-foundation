[Unit]
Description=FeetForcePlate expired terminal diagnostic package purge (RAY-802, RAY-927)
After=postgresql.service feetforceplate-seed.service

[Service]
Type=oneshot
User=feetforceplate
Group=feetforceplate
WorkingDirectory=/opt/feetforceplate/app
EnvironmentFile=/etc/feetforceplate/seed.env
Environment=FEETFORCEPLATE_VENV=/var/lib/feetforceplate/runtime/venv
Environment=XDG_CACHE_HOME=/var/lib/feetforceplate/runtime/cache
Environment=UV_OFFLINE=1
# stdout is only {"purged": <count>}; see the seed README for what else reaches the journal.
ExecStart=/opt/feetforceplate/app/deploy/aliyun/seed/venv-python.sh -m techflex_cloud_foundation.server.terminal_diagnostics.purge
TimeoutStartSec=30min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/feetforceplate/app /etc/feetforceplate/seed.env
ReadWritePaths=/var/lib/feetforceplate/objects /var/lib/feetforceplate/runtime
