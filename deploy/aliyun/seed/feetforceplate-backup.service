[Unit]
Description=FeetForcePlate encrypted seed backup
After=postgresql.service feetforceplate-seed.service

[Service]
Type=oneshot
User=feetforceplate
Group=feetforceplate
WorkingDirectory=/opt/feetforceplate/app
EnvironmentFile=/etc/feetforceplate/seed.env
Environment=FEETFORCEPLATE_VENV=/var/lib/feetforceplate/runtime/venv
Environment=XDG_CACHE_HOME=/var/lib/feetforceplate/runtime/cache
Environment=UV_OFFLINE=1
ExecStart=/opt/feetforceplate/app/deploy/aliyun/seed/backup.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/feetforceplate/app /etc/feetforceplate/seed.env
ReadWritePaths=/var/lib/feetforceplate/backups /var/lib/feetforceplate/runtime
