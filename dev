#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# uv merges configuration across levels, and a named index in a developer's
# ~/.config/uv/uv.toml outranks anything this project can declare: an empty
# uv.toml here, an explicit `[[index]] ... default = true`, a `[tool.uv]`
# table and UV_DEFAULT_INDEX were each tried and each still resolved through
# the mirror.  That matters because uv.lock records the URL every package was
# fetched from, so whichever index resolved becomes part of a committed
# artifact -- PR #44 carried 1486 lines rewriting all 722 of them and buried
# a three-package version bump underneath.
#
# Disabling discovery is the only thing that works.  It also discards this
# project's own `[tool.uv]`, which costs nothing while pyproject.toml has no
# such table; adding one means revisiting this line, because it would be
# ignored here and honoured by a bare `uv` call.
export UV_NO_CONFIG=1
uv_bin="${UV_BIN:-$(command -v uv 2>/dev/null || true)}"
if [ -z "$uv_bin" ] || [ ! -x "$uv_bin" ]; then
    echo "uv is required; install it as a device bootstrap prerequisite." >&2
    exit 127
fi

cd "$project_root"

sync() {
    "$uv_bin" sync --locked --extra dev --reinstall-package techflex-cloud-foundation
}

action="${1:-}"
shift || true
case "$action" in
    setup)
        [ "$#" -eq 0 ] || { echo "setup accepts no arguments" >&2; exit 2; }
        sync
        ;;
    test)
        [ "$#" -eq 0 ] || { echo "test accepts no arguments" >&2; exit 2; }
        sync
        "$uv_bin" run --locked --extra dev python -m pytest
        ;;
    lint)
        [ "$#" -eq 0 ] || { echo "lint accepts no arguments" >&2; exit 2; }
        sync
        "$uv_bin" run --locked --extra dev ruff check .
        "$uv_bin" run --locked --extra dev mypy src/techflex_cloud_foundation
        ;;
    build)
        [ "$#" -eq 0 ] || { echo "build accepts no arguments" >&2; exit 2; }
        sync
        release_dir="$(mktemp -d "${TMPDIR:-/tmp}/techflex-cloud-foundation.XXXXXX")"
        trap 'rm -rf "$release_dir"' EXIT
        "$uv_bin" build --out-dir "$release_dir"
        "$uv_bin" run --locked --extra dev python scripts/record_foundation_release_baseline.py \
            --project-root "$project_root" \
            --dist-dir "$release_dir" \
            --baseline-strategy legacy-httpx-client/1 \
            --output "$release_dir/release-evidence.json"
        ;;
    *)
        echo "usage: ./dev {setup|test|lint|build}" >&2
        exit 2
        ;;
esac
